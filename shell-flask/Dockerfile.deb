FROM quay.io/pypa/manylinux_2_28_x86_64 AS build

ARG APP_VERSION=1.0.0
ENV PYTHON=/opt/python/cp312-cp312/bin/python
WORKDIR /src

# manylinux's toolchain Python is intentionally static, while PyInstaller needs
# a shared libpython. Build only the matching core library; preserve manylinux's
# existing extension modules (SSL, bz2, lzma, etc.) and their bundled dependencies.
RUN mkdir -p /tmp/cpython \
    && curl -fsSL https://www.python.org/ftp/python/3.12.16/Python-3.12.16.tar.xz \
       | tar -xJ --strip-components=1 -C /tmp/cpython \
    && cd /tmp/cpython \
    && ./configure --prefix=/opt/python/cp312-cp312 --enable-shared \
         --with-ensurepip=no \
         LDFLAGS='-Wl,-rpath,/opt/python/cp312-cp312/lib' \
    && make -j2 libpython3.12.so \
    && cp libpython3.12.so.1.0 /opt/python/cp312-cp312/lib/ \
    && rm -rf /tmp/cpython
COPY shell-flask/requirements-linux*.txt shell-flask/
RUN ${PYTHON} -m pip install --no-cache-dir \
    -r shell-flask/requirements-linux-build.txt \
    && ${PYTHON} -m pip uninstall -y opencv-python \
    && ${PYTHON} -m pip install --no-cache-dir --force-reinstall --no-deps opencv-python-headless==5.0.0.93
COPY . .
RUN ${PYTHON} shell-flask/build_deb.py --version ${APP_VERSION}

FROM scratch AS artifact
COPY --from=build /src/shell-flask/dist/ocr-guoku-accounting_*_amd64.deb /
COPY --from=build /src/shell-flask/dist/ocr-guoku-accounting-*.tar.gz /
COPY --from=build /src/shell-flask/dist/SHA256SUMS /
