FROM quay.io/pypa/manylinux_2_28_x86_64 AS build

ARG APP_VERSION=1.0.0
ENV PYTHON=/opt/python/cp312-cp312/bin/python
WORKDIR /src

COPY . .
RUN ${PYTHON} -m pip install --no-cache-dir \
    -r shell-flask/requirements-linux-build.txt
# manylinux's toolchain Python is intentionally static, while PyInstaller needs
# a shared libpython. Rebuild the same CPython patch release as shared so the
# package still targets the image's glibc 2.28 baseline.
RUN mkdir -p /tmp/cpython \
    && curl -fsSL https://www.python.org/ftp/python/3.12.16/Python-3.12.16.tar.xz \
       | tar -xJ --strip-components=1 -C /tmp/cpython \
    && cd /tmp/cpython \
    && ./configure --prefix=/opt/python/cp312-cp312 --enable-shared \
         --with-ensurepip=no \
         LDFLAGS='-Wl,-rpath,/opt/python/cp312-cp312/lib' \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf /tmp/cpython
RUN ${PYTHON} shell-flask/build_deb.py --version ${APP_VERSION}

FROM scratch AS artifact
COPY --from=build /src/shell-flask/dist/ocr-guoku-accounting_*_amd64.deb /
